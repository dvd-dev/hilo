#!/usr/bin/env bash

set -e

cd "$(dirname "$0")/.."

# Activate the virtual environment
source "${VIRTUAL_ENV}/bin/activate"

# Create config dir if not present
if [[ ! -d "${PWD}/config" ]]; then
    mkdir -p "${PWD}/config"
    hass --config "${PWD}/config" --script ensure_config
fi

# Set the path to workspace root so custom_components.hilo can be imported by Home Assistant
export PYTHONPATH="${PWD}${PYTHONPATH:+:${PYTHONPATH}}"

# Check if python-hilo exists and install it in editable development mode
if [[ -d "/workspaces/python-hilo/pyhilo" ]]; then
    echo "Installing custom version of python-hilo (editable)..."
    uv pip install -e "/workspaces/python-hilo"
    SKIP_PACKAGES="--skip-pip-packages python-hilo"
else
    echo "Using PyPI version of python-hilo..."
    SKIP_PACKAGES=""
fi

# Start Home Assistant
hass --config "${PWD}/config" --debug ${SKIP_PACKAGES}
