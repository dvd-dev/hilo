#!/usr/bin/env bash
set -e

echo "Setting up Hilo development environment..."
cd "$(dirname "$0")/.."

# Install the project in editable mode
uv pip install -e .

# Install pre-commit git hooks if pre-commit is available
if command -v pre-commit &> /dev/null; then
    pre-commit install
    pre-commit install --hook-type commit-msg
fi

# If python-hilo is mounted in sibling directory, install in editable mode
if [[ -d "/workspaces/python-hilo/pyhilo" ]]; then
    echo "Found local python-hilo, installing in editable mode..."
    uv pip install -e "/workspaces/python-hilo"
fi

echo "Development environment setup complete!"
